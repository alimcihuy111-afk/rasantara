                                <ellipse cx="100" cy="135" rx="50" ry="12" fill="#D97706"/>
                                <!-- Decorative Leaves Base -->
                                <path d="M40 140 Q 60 120 80 140 Q 100 120 120 140 Q 140 120 160 140 Q 100 170 40 140 Z" fill="#15803D"/>
                                <!-- Chili/Garnish Accent -->
                                <path d="M 65 110 Q 55 90 45 95" stroke="#DC2626" stroke-width="5" stroke-linecap="round" fill="none"/>
                                <!-- Star Compass top -->
                                <polygon points="100,15 104,25 100,30 96,25" fill="#B45309"/>

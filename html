        // Render Recipe Cards
        function renderRecipes(items) {
            const grid = document.getElementById('recipeGrid');
            const emptyState = document.getElementById('emptyState');
            const recipeCount = document.getElementById('recipeCount');

            grid.innerHTML = '';
            recipeCount.innerText = `${items.length} Resep Tersedia`;

            if (items.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            items.forEach(recipe => {
                const card = document.createElement('div');
                card.className = "bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 flex flex-col cursor-pointer border border-orange-100/80 group";
                card.onclick = () => openModal(recipe.id);

                card.innerHTML = `

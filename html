        <div class="absolute -bottom-10 -left-10 w-60 h-60 bg-black/10 rounded-full blur-xl pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 relative z-10">

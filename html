    </header>

    <!-- MAIN CONTAINER -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow w-full">
        
        <!-- CATEGORY NAVIGATION / TABS -->
        <section class="mb-8">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
                    <i class="fas fa-map-marked-alt text-brand-500"></i> Kategori Daerah
                </h2>
                <span id="recipeCount" class="text-xs font-semibold text-brand-600 bg-brand-100 px-3 py-1 rounded-full">7 Resep Tersedia</span>
            </div>

            <!-- Tab Buttons Container (Scrollable on mobile) -->
            <div class="flex items-center gap-2 overflow-x-auto pb-3 pt-1 scrollbar-none no-scrollbar">
                <button onclick="selectCategory('all')" id="tab-all" class="category-tab px-5 py-2.5 rounded-full text-sm font-semibold whitespace-nowrap transition duration-200 bg-brand-500 text-white shadow-md hover:bg-brand-600 flex items-center gap-2">
                    <i class="fas fa-globe-asia"></i> Semua Daerah
                </button>
                <button onclick="selectCategory('Sumatera')" id="tab-Sumatera" class="category-tab px-5 py-2.5 rounded-full text-sm font-semibold whitespace-nowrap transition duration-200 bg-white text-gray-600 hover:bg-orange-100 hover:text-brand-600 shadow-sm border border-orange-100 flex items-center gap-2">
                    <i class="fas fa-mountain"></i> Sumatera
                </button>
                <button onclick="selectCategory('Jawa')" id="tab-Jawa" class="category-tab px-5 py-2.5 rounded-full text-sm font-semibold whitespace-nowrap transition duration-200 bg-white text-gray-600 hover:bg-orange-100 hover:text-brand-600 shadow-sm border border-orange-100 flex items-center gap-2">
                    <i class="fas fa-monument"></i> Jawa
                </button>
                <button onclick="selectCategory('Kalimantan')" id="tab-Kalimantan" class="category-tab px-5 py-2.5 rounded-full text-sm font-semibold whitespace-nowrap transition duration-200 bg-white text-gray-600 hover:bg-orange-100 hover:text-brand-600 shadow-sm border border-orange-100 flex items-center gap-2">
                    <i class="fas fa-tree"></i> Kalimantan
                </button>
                <button onclick="selectCategory('Sulawesi')" id="tab-Sulawesi" class="category-tab px-5 py-2.5 rounded-full text-sm font-semibold whitespace-nowrap transition duration-200 bg-white text-gray-600 hover:bg-orange-100 hover:text-brand-600 shadow-sm border border-orange-100 flex items-center gap-2">
                    <i class="fas fa-water"></i> Sulawesi
                </button>
                <button onclick="selectCategory('NTB')" id="tab-NTB" class="category-tab px-5 py-2.5 rounded-full text-sm font-semibold whitespace-nowrap transition duration-200 bg-white text-gray-600 hover:bg-orange-100 hover:text-brand-600 shadow-sm border border-orange-100 flex items-center gap-2">
                    <i class="fas fa-umbrella-beach"></i> NTB
                </button>
                <button onclick="selectCategory('NTT')" id="tab-NTT" class="category-tab px-5 py-2.5 rounded-full text-sm font-semibold whitespace-nowrap transition duration-200 bg-white text-gray-600 hover:bg-orange-100 hover:text-brand-600 shadow-sm border border-orange-100 flex items-center gap-2">
                    <i class="fas fa-sun"></i> NTT
                </button>
                <button onclick="selectCategory('Papua')" id="tab-Papua" class="category-tab px-5 py-2.5 rounded-full text-sm font-semibold whitespace-nowrap transition duration-200 bg-white text-gray-600 hover:bg-orange-100 hover:text-brand-600 shadow-sm border border-orange-100 flex items-center gap-2">
                    <i class="fas fa-feather-alt"></i> Papua
                </button>
            </div>
        </section>

        <!-- RECIPE CARDS GRID -->
        <section id="recipeGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            <!-- Dynamic Recipe Cards injected here via JavaScript -->
        </section>

        <!-- EMPTY STATE (SHOWS WHEN NO RECIPE MATCHES SEARCH) -->
        <div id="emptyState" class="hidden text-center py-16 px-4">
            <div class="w-20 h-20 bg-orange-100 text-brand-500 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl">
                <i class="fas fa-utensils"></i>
            </div>
            <h3 class="text-xl font-bold text-gray-800 mb-1">Resep Tidak Ditemukan</h3>
            <p class="text-gray-500 text-sm max-w-sm mx-auto">Coba cari dengan kata kunci lain atau pilih kategori daerah yang berbeda.</p>
        </div>
    </main>

    <!-- RECIPE DETAIL MODAL POPUP -->
    <div id="recipeModal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/60 backdrop-blur-sm transition-opacity duration-300 flex items-center justify-center p-3 sm:p-4 md:p-6">
        
        <div class="bg-white rounded-3xl shadow-2xl max-w-3xl w-full max-h-[90vh] overflow-hidden flex flex-col transform transition-all scale-95 opacity-0 duration-300" id="modalContainer">
            
            <!-- Modal Header with Image & Title Overlay -->
            <div class="relative h-60 sm:h-72 w-full flex-shrink-0 bg-gray-200">
                <img id="modalImg" src="" alt="Foto Makanan" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent"></div>
                
                <!-- Close Button -->
                <button onclick="closeModal()" class="absolute top-4 right-4 bg-white/80 hover:bg-white text-gray-800 w-10 h-10 rounded-full flex items-center justify-center transition shadow-lg backdrop-blur-md">
                    <i class="fas fa-times text-lg"></i>
                </button>

                <!-- Badge & Title -->
                <div class="absolute bottom-4 left-4 right-4 text-white">
                    <span id="modalRegionBadge" class="bg-brand-500 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider inline-block mb-2 shadow">
                        Daerah
                    </span>
                    <h2 id="modalTitle" class="text-2xl sm:text-3xl font-serif font-bold leading-tight drop-shadow">
                        Nama Makanan
                    </h2>
                    <p id="modalSubRegion" class="text-orange-200 text-xs sm:text-sm font-medium flex items-center gap-1.5 mt-1">
                        <i class="fas fa-map-marker-alt"></i> Asal: Sumatera Barat
                    </p>
                </div>
            </div>

            <!-- Modal Content Body (Scrollable) -->
            <div class="p-5 sm:p-7 overflow-y-auto space-y-6 flex-grow">
                
                <!-- Section 1: Asal-Usul -->
                <div class="bg-orange-50/60 p-4 rounded-2xl border border-orange-100">
                    <h3 class="text-base font-bold text-brand-700 mb-2 flex items-center gap-2">
                        <i class="fas fa-book-open"></i> Asal-Usul & Latar Belakang
                    </h3>
                    <p id="modalOrigin" class="text-gray-700 text-sm leading-relaxed">
                        Deskripsi asal-usul makanan...
                    </p>
                </div>

                <!-- Section 2: Bahan-Bahan -->
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2 border-b border-gray-100 pb-2">
                        <i class="fas fa-shopping-basket text-brand-500"></i> Bahan-Bahan
                    </h3>
                    <p class="text-xs text-gray-500 mb-3"><i class="fas fa-info-circle"></i> Centang bahan yang sudah kamu siapkan:</p>
                    <ul id="modalIngredients" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-gray-700">
                        <!-- Ingredients List Dynamic -->
                    </ul>
                </div>

                <!-- Section 3: Langkah Memasak -->
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2 border-b border-gray-100 pb-2">
                        <i class="fas fa-list-ol text-brand-500"></i> Langkah-Langkah Memasak
                    </h3>
                    <ol id="modalSteps" class="space-y-3 text-sm text-gray-700">
                        <!-- Steps Dynamic -->
                    </ol>
                </div>

                <!-- Section 4: Tips Rahasia -->
                <div class="bg-amber-50 p-4 rounded-2xl border border-amber-200/60 flex gap-3.5 items-start">
                    <div class="w-9 h-9 bg-amber-500 text-white rounded-xl flex items-center justify-center flex-shrink-0 shadow-md">
                        <i class="fas fa-lightbulb text-lg"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-amber-900 text-sm mb-1">Tips Rahasia Chef Rasantara</h4>
                        <p id="modalTips" class="text-amber-800 text-xs sm:text-sm leading-relaxed">
                            Tips spesial...
                        </p>
                    </div>
                </div>

            </div>

            <!-- Modal Footer -->
            <div class="p-4 bg-gray-50 border-t border-gray-100 flex justify-end">
                <button onclick="closeModal()" class="px-6 py-2.5 bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold rounded-full transition shadow-md">
                    Tutup Resep
                </button>
            </div>

        </div>
    </div>

    <!-- ADD RECIPE MODAL FORM -->
    <div id="addRecipeModal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-black/60 backdrop-blur-sm transition-opacity duration-300 flex items-center justify-center p-3 sm:p-4 md:p-6">
        <div class="bg-white rounded-3xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-hidden flex flex-col transform transition-all scale-95 opacity-0 duration-300" id="addModalContainer">
            
            <!-- Modal Header -->
            <div class="bg-gradient-to-r from-brand-500 to-amber-500 p-5 sm:p-6 text-white flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-xl">
                        <i class="fas fa-utensils"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold font-serif">Bagikan Resep Nusantara</h2>
                        <p class="text-xs text-orange-100">Tambahkan sajian kebanggaan daerahmu ke Rasantara</p>
                    </div>
                </div>
                <button onclick="closeAddRecipeModal()" class="bg-white/20 hover:bg-white/40 text-white w-9 h-9 rounded-full flex items-center justify-center transition">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Modal Form Body -->
            <form id="addRecipeForm" onsubmit="handleAddRecipe(event)" class="p-5 sm:p-6 overflow-y-auto space-y-4 flex-grow text-gray-700">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Nama Makanan -->
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Nama Makanan *</label>
                        <input type="text" id="newRecipeName" required placeholder="Contoh: Mie Aceh Kak Mue" 
                            class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm">
                    </div>
                    <!-- Kategori Daerah -->
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Kategori Daerah *</label>
                        <select id="newRecipeRegion" required class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm bg-white">
                            <option value="Sumatera">Sumatera</option>
                            <option value="Jawa">Jawa</option>
                            <option value="Kalimantan">Kalimantan</option>
                            <option value="Sulawesi">Sulawesi</option>
                            <option value="NTB">NTB</option>
                            <option value="NTT">NTT</option>
                            <option value="Papua">Papua</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Detail Kota/Provinsi -->
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Spesifik Asal Daerah *</label>
                        <input type="text" id="newRecipeSubRegion" required placeholder="Contoh: Aceh / Banda Aceh" 
                            class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm">
                    </div>
                    <!-- URL Gambar -->
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">URL Gambar (Opsional)</label>
                        <input type="url" id="newRecipeImage" placeholder="https://..." 
                            class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm">
                    </div>
                </div>

                <!-- Asal-Usul / Sejarah -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Asal-Usul / Sejarah Singkat *</label>
                    <textarea id="newRecipeOrigin" required rows="2" placeholder="Ceritakan sedikit latar belakang atau tradisi masakan ini..." 
                        class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm"></textarea>
                </div>

                <!-- Bahan-Bahan -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Bahan-Bahan * <span class="text-gray-400 font-normal lowercase">(pisahkan dengan baris baru)</span></label>
                    <textarea id="newRecipeIngredients" required rows="3" placeholder="500g daging sapi&#10;3 siung bawang putih&#10;1 sdt garam" 
                        class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm"></textarea>
                </div>

                <!-- Langkah Memasak -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Langkah Memasak * <span class="text-gray-400 font-normal lowercase">(pisahkan dengan baris baru)</span></label>
                    <textarea id="newRecipeSteps" required rows="3" placeholder="Tumis bumbu hingga harum.&#10;Masukkan bahan utama lalu aduk rata.&#10;Masak hingga matang dan sajikan." 
                        class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm"></textarea>
                </div>

                <!-- Tips Memasak -->
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Tips Rahasia Memasak *</label>
                    <input type="text" id="newRecipeTips" required placeholder="Contoh: Gunakan api kecil agar bumbu lebih meresap sempurna." 
                        class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm">
                </div>

                <!-- Submit Button Inside Form Footer -->
                <div class="pt-3 border-t border-gray-100 flex items-center justify-end gap-3">
                    <button type="button" onclick="closeAddRecipeModal()" class="px-5 py-2.5 text-gray-600 hover:bg-gray-100 rounded-full text-sm font-semibold transition">
                        Batal
                    </button>
                    <button type="submit" class="px-6 py-2.5 bg-brand-500 hover:bg-brand-600 text-white rounded-full text-sm font-semibold transition shadow-md flex items-center gap-2">
                        <i class="fas fa-paper-plane"></i> Simpan & Publikasikan
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="bg-white border-t border-orange-100 py-6 mt-12">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <div class="flex items-center justify-center gap-2 mb-2">
                <span class="font-serif font-bold text-xl text-brand-500">Rasantara</span>
                <span class="text-xs bg-orange-100 text-brand-600 font-bold px-2 py-0.5 rounded-full">Resep Nusantara</span>
            </div>
            <p class="text-xs text-gray-500">© 2026 Rasantara - Warisan Kuliner Kaya Rasa Indonesia. Dibuat dengan penuh rasa cinta pada masakan daerah.</p>
        </div>
    </footer>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Database Makanan Nusantara (1 Makanan per 7 Daerah)
        const recipes = [
            {
                id: 'rendang',
                name: 'Rendang Daging',
                region: 'Sumatera',
                subRegion: 'Sumatera Barat (Minangkabau)',
                image: 'https://images.unsplash.com/photo-1626777552726-4a6b54c97e46?auto=format&fit=crop&w=800&q=80',
                cookingTime: '4 Jam',
                difficulty: 'Sedang - Tinggi',
                origin: 'Rendang lahir dari tradisi merantau masyarakat Minangkabau. Proses memasak santan dan rempah dalam waktu lama menghasilkan olahan daging yang tahan lama hingga berminggu-minggu, cocok sebagai bekal perjalanan jauh para perantau Minang.',
                ingredients: [
                    '1 kg daging sapi khas dalam/paha',
                    '1.000 ml santan kental dari 3 butir kelapa',
                    '2 lembar daun kunyit, simpulkan',
                    '4 lembar daun jeruk purut',
                    '2 batang serai, memarkan',
                    '2 buah asam kandis',
                    '12 siung bawang merah & 6 siung bawang putih',
                    '100g cabai merah keriting',
                    '2 cm jahe, lengkuas & kunyit bakar'
                ],
                steps: [
                    'Haluskan bawang merah, bawang putih, cabai, jahe, kunyit, dan lengkuas.',
                    'Didihkan santan kental bersama bumbu halus, daun kunyit, daun jeruk, dan serai sambil terus diaduk agar santan tidak pecah.',
                    'Setelah santan mengeluarkan minyak dan mengental, masukkan potongan daging sapi.',
                    'Kecilkan api, masak terus hingga cairan menyusut (kalio) dan terus aduk perlahan hingga bumbu berubah warna menjadi cokelat kehitaman dan kering minyak.'
                ],
                tips: 'Gunakan santan murni dari kelapa tua. Jangan berhenti mengaduk saat proses pengentalan awal agar santan pecah minyak sempurna dan bumbu tidak gosong di dasar wajan.'
            },
            {
                id: 'rawon',
                name: 'Rawon Daging Sapi',
                region: 'Jawa',
                subRegion: 'Jawa Timur (Surabaya)',
                image: 'https://images.unsplash.com/photo-1541832676-9b763b0239ab?auto=format&fit=crop&w=800&q=80',

        // Category Filter Logic
        function selectCategory(category) {
            currentCategory = category;
            
            // Update Tab UI
            document.querySelectorAll('.category-tab').forEach(tab => {
                tab.classList.remove('bg-brand-500', 'text-white', 'shadow-md');
                tab.classList.add('bg-white', 'text-gray-600', 'hover:bg-orange-100', 'hover:text-brand-600', 'border', 'border-orange-100');
            });

            const activeTab = document.getElementById(`tab-${category}`);
            if (activeTab) {
                activeTab.classList.remove('bg-white', 'text-gray-600', 'hover:bg-orange-100', 'hover:text-brand-600', 'border', 'border-orange-100');
                activeTab.classList.add('bg-brand-500', 'text-white', 'shadow-md');
            }

            filterRecipes();
        }

        // Search & Filter Combined Logic
        function filterRecipes() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            
            const filtered = recipes.filter(recipe => {
                const matchesCategory = currentCategory === 'all' || recipe.region.toLowerCase() === currentCategory.toLowerCase();
                const matchesSearch = recipe.name.toLowerCase().includes(query) || 
                                      recipe.region.toLowerCase().includes(query) ||
                                      recipe.subRegion.toLowerCase().includes(query) ||
                                      recipe.ingredients.some(ing => ing.toLowerCase().includes(query));

                return matchesCategory && matchesSearch;
            });

            renderRecipes(filtered);
        }

        // Open Modal Function
        function openModal(id) {
            const recipe = recipes.find(r => r.id === id);
            if (!recipe) return;

            document.getElementById('modalImg').src = recipe.image;
            document.getElementById('modalTitle').innerText = recipe.name;
            document.getElementById('modalRegionBadge').innerText = recipe.region;
            document.getElementById('modalSubRegion').innerHTML = `<i class="fas fa-map-marker-alt"></i> Asal: ${recipe.subRegion}`;
            document.getElementById('modalOrigin').innerText = recipe.origin;
            document.getElementById('modalTips').innerText = recipe.tips;

            // Render Ingredients Checkbox
            const ingContainer = document.getElementById('modalIngredients');
            ingContainer.innerHTML = '';
            recipe.ingredients.forEach((item, index) => {
                const li = document.createElement('li');
                li.className = "flex items-start gap-2 bg-orange-50/40 p-2 rounded-lg border border-orange-100/60";
                li.innerHTML = `
                    <input type="checkbox" id="ing-${index}" class="mt-1 accent-brand-500 h-4 w-4 rounded cursor-pointer">
                    <label for="ing-${index}" class="cursor-pointer select-none leading-tight text-gray-700">${item}</label>
                `;
                ingContainer.appendChild(li);
            });

            // Render Steps List
            const stepsContainer = document.getElementById('modalSteps');
            stepsContainer.innerHTML = '';
            recipe.steps.forEach((step, index) => {
                const li = document.createElement('li');
                li.className = "flex gap-3 items-start bg-gray-50 p-3 rounded-xl";
                li.innerHTML = `
                    <span class="w-6 h-6 bg-brand-500 text-white rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5 shadow-sm">
                        ${index + 1}
                    </span>
                    <p class="text-gray-700 text-sm leading-relaxed">${step}</p>
                `;
                stepsContainer.appendChild(li);
            });

            // Show Modal with Animation
            const modal = document.getElementById('recipeModal');
            const container = document.getElementById('modalContainer');
            modal.classList.remove('hidden');
            setTimeout(() => {
                container.classList.remove('scale-95', 'opacity-0');
                container.classList.add('scale-100', 'opacity-100');
            }, 10);

            document.body.style.overflow = 'hidden'; // Prevent background scrolling
        }

        // Close Modal Function
        function closeModal() {
            const modal = document.getElementById('recipeModal');
            const container = document.getElementById('modalContainer');

            container.classList.remove('scale-100', 'opacity-100');
            container.classList.add('scale-95', 'opacity-0');

            setTimeout(() => {
                modal.classList.add('hidden');
                document.body.style.overflow = 'auto';
            }, 250);
        }

        // Close modal when clicking outside content
        document.getElementById('recipeModal').addEventListener('click', (e) => {
            if (e.target.id === 'recipeModal') {
                closeModal();
            }
        });

        // Open Add Recipe Modal
        function openAddRecipeModal() {
            const modal = document.getElementById('addRecipeModal');
            const container = document.getElementById('addModalContainer');
            modal.classList.remove('hidden');
            setTimeout(() => {
                container.classList.remove('scale-95', 'opacity-0');
                container.classList.add('scale-100', 'opacity-100');
            }, 10);
            document.body.style.overflow = 'hidden';
        }

        // Close Add Recipe Modal
        function closeAddRecipeModal() {
            const modal = document.getElementById('addRecipeModal');
            const container = document.getElementById('addModalContainer');
            container.classList.remove('scale-100', 'opacity-100');
            container.classList.add('scale-95', 'opacity-0');

            setTimeout(() => {
                modal.classList.add('hidden');
                document.body.style.overflow = 'auto';
                document.getElementById('addRecipeForm').reset();
            }, 250);
        }

        // Close Add Recipe Modal when clicking backdrop
        document.getElementById('addRecipeModal').addEventListener('click', (e) => {
            if (e.target.id === 'addRecipeModal') {
                closeAddRecipeModal();
            }
        });

        // Handle Add New Recipe Form Submission
        function handleAddRecipe(e) {
            e.preventDefault();

            const name = document.getElementById('newRecipeName').value.trim();
            const region = document.getElementById('newRecipeRegion').value;
            const subRegion = document.getElementById('newRecipeSubRegion').value.trim();
            let image = document.getElementById('newRecipeImage').value.trim();
            const origin = document.getElementById('newRecipeOrigin').value.trim();
            const ingredientsRaw = document.getElementById('newRecipeIngredients').value.trim();
            const stepsRaw = document.getElementById('newRecipeSteps').value.trim();
            const tips = document.getElementById('newRecipeTips').value.trim();

            // Default image fallback if user leaves URL empty
            if (!image) {
                image = 'https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=800&q=80';
            }

            // Split multiline input into array
            const ingredients = ingredientsRaw.split('\n').filter(item => item.trim() !== '');
            const steps = stepsRaw.split('\n').filter(item => item.trim() !== '');

            const newRecipe = {
                id: 'custom-' + Date.now(),
                name: name,
                region: region,
                subRegion: subRegion,
                image: image,
                cookingTime: '30-60 Min',
                difficulty: 'Khas Daerah',
                origin: origin,
                ingredients: ingredients,
                steps: steps,
                tips: tips
            };

            // Unshift to place new recipe at the top
            recipes.unshift(newRecipe);

            // Close Modal & Reset Form
            closeAddRecipeModal();

            // Filter & Render Updated Recipes
            filterRecipes();
        }
    </script>
</body>

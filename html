                            <!-- SVG Decorative Logo inspired by Tumpeng Nusantara -->
                            <svg viewBox="0 0 200 200" class="w-full h-full">
                                <circle cx="100" cy="100" r="95" fill="#FFF7ED" stroke="#FF7A00" stroke-width="4"/>

                        <p class="text-orange-100 mt-1.5 text-sm md:text-base font-medium max-w-md">
                            Jelajah Cita Rasa Resep Kuliner Autentik Nusantara
                        </p>
                    </div>
                </div>

                <!-- Action Bar: Live Search & Add Recipe Button -->
                <div class="w-full md:w-auto flex flex-col sm:flex-row items-center gap-3">
                    <div class="w-full sm:w-72 relative">
                        <input type="text" id="searchInput" onkeyup="filterRecipes()" placeholder="Cari resep atau bahan..." 
